<odoo>
    <data noupdate="1">
        <record id="email_template_stock_alert" model="mail.template">
            <field name="name">Stock Alert Notification</field>
            <field name="model_id" ref="model_stock_alert_log"/>
            <field name="subject">
                ⚠️ Low Stock Alert: {{ object.product_id.display_name }}
            </field>
            <field name="email_from">{{ user.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2 style="color: #e74c3c;">⚠️ Low Stock Alert</h2>
                    <p>The following product has fallen at or below its minimum threshold:</p>
                    <table style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #f8f8f8;">
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Product</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.product_id.display_name }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Quantity on Hand</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.qty_on_hand }}
                            </td>
                        </tr>
                        <tr style="background-color: #f8f8f8;">
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Minimum Threshold</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.min_qty }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Alert Date</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.date }}
                            </td>
                        </tr>
                        <tr style="background-color: #f8f8f8;">
                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Alert Rule</strong></td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                {{ object.rule_id.name }}
                            </td>
                        </tr>
                    </table>
                    <p style="margin-top: 20px; color: #888;">
                        This is an automated alert from the Stock Alert &amp; Reorder module.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>