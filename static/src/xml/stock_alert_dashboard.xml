<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="stock_alert_reorder.StockAlertDashboard">
        <div class="o_stock_alert_dashboard p-4">

            <div class="d-flex align-items-center mb-4">
                <h2 class="mb-0">⚠️ Critical Stock Dashboard</h2>
            </div>

            <t t-if="state.loading">
                <div class="text-muted">Loading stock data...</div>
            </t>

            <t t-elif="state.items.length === 0">
                <div class="alert alert-success">
                    ✅ All stock levels are healthy. No critical items found.
                </div>
            </t>

            <t t-else="">
                <div class="alert alert-warning mb-3">
                    <strong>
                        <t t-esc="state.items.length"/> product(s)
                    </strong>
                    below minimum threshold.
                </div>

                <table class="table table-bordered table-hover">
                    <thead class="table-danger">
                        <tr>
                            <th>Product</th>
                            <th>Qty on Hand</th>
                            <th>Min Threshold</th>
                            <th>Reorder Qty</th>
                            <th>Alert Rule</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.items"
                           t-as="item"
                           t-key="item_index">
                            <tr>
                                <td>
                                    <strong>
                                        <t t-esc="item.product_name"/>
                                    </strong>
                                </td>
                                <td class="text-danger fw-bold">
                                    <t t-esc="item.qty_on_hand"/>
                                </td>
                                <td><t t-esc="item.min_qty"/></td>
                                <td><t t-esc="item.reorder_qty"/></td>
                                <td><t t-esc="item.rule_name"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

        </div>
    </t>

</templates>