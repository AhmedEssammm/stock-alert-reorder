<odoo>
    <record id="view_stock_alert_rule_tree" model="ir.ui.view">
        <field name="name">stock.alert.rule.tree</field>
        <field name="model">stock.alert.rule</field>
        <field name="arch" type="xml">
            <tree string="Stock Alert Rules">
                <field name="name"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="min_qty"/>
                <field name="reorder_qty"/>
                <field name="auto_purchase"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_alert_rule_form" model="ir.ui.view">
        <field name="name">stock.alert.rule.form</field>
        <field name="model">stock.alert.rule</field>
        <field name="arch" type="xml">
            <form string="Stock Alert Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Low Stock – Laptops"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="product_id"/>
                            <field name="categ_id"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Thresholds">
                            <field name="min_qty"/>
                            <field name="reorder_qty"/>
                        </group>
                        <group>
                            <group string="Actions">
                                <field name="auto_purchase"/>
                                <field name="alert_email"/>
                            </group>
                            <group string="Status">
                                <field name="active"/>
                            </group>
                        </group>
                    </group>
                    <header>
                        <button name="action_test_detection"
                                string="Run Detection Test"
                                type="object"
                                class="oe_highlight"/>
                    </header>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_alert_rule" model="ir.actions.act_window">
        <field name="name">Stock Alert Rules</field>
        <field name="res_model">stock.alert.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_alert_root"
              name="Stock Alerts"
              parent="stock.menu_stock_config_settings"
              action="action_stock_alert_rule"
              sequence="50"
    />
</odoo>